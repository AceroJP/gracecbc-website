# Copy this file to .env.local and enter the values from your Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
CLOUDCONVERT_API_KEY=

# Server-only SMTP for contributor approval and rejection notifications.
# Use a Gmail app password if SMTP_HOST is smtp.gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
